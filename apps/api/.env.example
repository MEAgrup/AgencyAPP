# Supabase API & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...placeholder
SUPABASE_JWT_SECRET=your-jwt-secret-placeholder

# Database URLs (connection pooler & direct)
DATABASE_URL=postgresql://postgres:password@localhost:6543/cdps
DIRECT_URL=postgresql://postgres:password@localhost:5432/cdps

# Node environment
NODE_ENV=development

# Bridge katalog PX Exchange (CDPS→MCN, docs/BRIDGE_PX_CATALOG_CONTRACT.md).
# BRIDGE_PX_SECRET sudah dipakai Flow C (MCN→CDPS, /internal/bridge/px-coverage)
# — SAMA secret, bukan baru. MCN_BRIDGE_URL = URL dasar deployment mcnapp.
BRIDGE_PX_SECRET=your-bridge-px-secret-placeholder
MCN_BRIDGE_URL=https://mcn.meaagency.co.id
