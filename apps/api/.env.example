# Supabase API & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...placeholder

# JWT verification.
# Newer Supabase projects sign access tokens with an ASYMMETRIC key (ES256); the
# API verifies those via the project JWKS endpoint automatically (no secret needed).
# Set SUPABASE_JWT_SECRET ONLY if the project still uses the legacy HS256 shared
# secret (Settings -> API -> JWT Keys -> Legacy JWT Secret).
# SUPABASE_JWT_SECRET=your-legacy-hs256-secret

# Database URL (Supabase Transaction pooler, port 6543 — used by apps/api)
DATABASE_URL=postgresql://postgres.<project-ref>:password@aws-0-<region>.pooler.supabase.com:6543/postgres

# Node environment
NODE_ENV=development
